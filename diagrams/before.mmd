flowchart TD
  classDef disabled fill:#f5f5f5,stroke:#999,stroke-dasharray: 5 5,color:#666;

  Start["Start (single process)"]
  Parse["Parse CLI options"]
  Load["Load instance data"]
  Init["Initialize parameters + RNG"]
  InitPop["Build initial population\n(random tours -> split -> local search)"]
  LoopCond{{Stop? time limit or no-improve}}
  Offspring["Create offspring\n(selection + crossover + split)"]
  Eval["Local search + feasibility repair"]
  Update["Update population + penalties + traces"]
  Restart{{Restart? time limit + stagnation}}
  Output["Write best solution + progress"]

  MPIOff["MPI: not used"]:::disabled
  OMPOff["OpenMP: not used"]:::disabled

  Start --> Parse --> Load --> Init --> InitPop --> LoopCond
  LoopCond -- no --> Offspring --> Eval --> Update --> Restart
  Restart -- yes --> InitPop
  Restart -- no --> LoopCond
  LoopCond -- yes --> Output

  MPIOff -.-> Start
  OMPOff -.-> InitPop

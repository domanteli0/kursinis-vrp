flowchart TD
  classDef changed fill:#ffe6b3,stroke:#cc7a00,stroke-width:1px;

  Start["Start (MPI rank)"]
  MPIInit["MPI init + rank/size"]:::changed
  Seed["Rank-based seed offset; quiet non-root"]:::changed
  Parse["Parse CLI options"]
  Load["Load instance data"]
  Init["Initialize parameters + thread-local RNG"]:::changed
  InitPop["Build initial population\n(split + local search per individual)"]:::changed
  LoopCond{{Stop? time limit or no-improve}}
  Offspring["Create offspring\n(selection + crossover + split)"]
  Eval["Local search + feasibility repair"]:::changed
  Update["Update population + penalties + traces"]
  Restart{{Restart? time limit + stagnation}}
  Output["Write best solution + progress\n(rank-suffixed for non-root)"]:::changed
  MPIReduce["MPI reduce: report global best"]:::changed
  OMPNote["OpenMP workers evaluate individuals\n(parallel regions)"]:::changed

  Start --> MPIInit --> Seed --> Parse --> Load --> Init --> InitPop --> LoopCond
  LoopCond -- no --> Offspring --> Eval --> Update --> Restart
  Restart -- yes --> InitPop
  Restart -- no --> LoopCond
  LoopCond -- yes --> Output --> MPIReduce

  OMPNote -.-> InitPop
  OMPNote -.-> Eval
